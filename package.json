{
  "name": "tvmod",
  "version": "0.15.1",
  "description": "Local modification host for TradingView Desktop",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/HalloTheEngineer/TVMod.git"
  },
  "homepage": "https://github.com/HalloTheEngineer/TVMod",
  "bugs": {
    "url": "https://github.com/HalloTheEngineer/TVMod/issues"
  },
  "bin": {
    "tvmod": "bin/tvmod"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:binary": "node scripts/build-binary.mjs",
    "package:release": "node scripts/package-release.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "dev": "npm run build && node dist/cli.mjs",
    "census": "node tools/census/collect.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@electron/asar": "^4.3.2"
  }
}
